{
  "family": "planilla-pda-task",
  "containerDefinitions": [
    {
      "name": "planilla-pda-container",
      "image": "372219958098.dkr.ecr.sa-east-1.amazonaws.com/planilla-pda-repository:<SHA>",
      "cpu": 0,
      "memory": 512,
      "portMappings": [{ "containerPort": 5000, "hostPort": 5000, "protocol": "tcp" }],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/planilla-pda-task",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "secrets": [
        { "name": "PORT",                  "valueFrom": "arn:aws:secretsmanager:sa-east-1:372219958098:secret:opencars-credentials:PORT::" },
        { "name": "NODE_ENV",              "valueFrom": "arn:aws:secretsmanager:sa-east-1:372219958098:secret:opencars-credentials:NODE_ENV::" },
        { "name": "HOST",                  "valueFrom": "arn:aws:secretsmanager:sa-east-1:372219958098:secret:opencars-credentials:HOST::" },
        { "name": "MONGODB_URI",           "valueFrom": "arn:aws:secretsmanager:sa-east-1:372219958098:secret:opencars-credentials:MONGODB_URI::" },
        { "name": "MONGODB_NAME_PLANILLA-PAGOS-PDA",            "valueFrom": "arn:aws:secretsmanager:sa-east-1:372219958098:secret:opencars-credentials:MONGODB_NAME_PLANILLA-PAGOS-PDA::" },
        { "name": "CORTE_PASSWORD",        "valueFrom": "arn:aws:secretsmanager:sa-east-1:372219958098:secret:opencars-credentials:CORTE_PASSWORD::" }
      ]
    }
  ],
  "taskRoleArn": "arn:aws:iam::372219958098:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::372219958098:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX"
  }
}
